# =============================================================================
# Suhail AI — required environment variables
# Copy to `.env` for local dev. NEVER commit a real `.env`.
#
# Anything with a VITE_ prefix is inlined into the client bundle => PUBLIC.
# Plain names are read server-side only by the /api/ serverless functions => SECRET.
# =============================================================================

# --- Client (public) ---
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional; if unset the app falls back to <origin>/auth/callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.com
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# --- Server-only (Vercel environment, NOT prefixed with VITE_) ---
# Set these in Vercel > project > Settings > Environment Variables (Production).
# Never put them in a VITE_ var or in the client bundle.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret